										},
										"Filename": {
											"value": "@concat('yellow_tripdata_',item(), '.parquet' )\n",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"ano": {
				"type": "String",
				"defaultValue": "2024"
