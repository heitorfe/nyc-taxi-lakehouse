{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "sia-dp203-data-factory"
		},
		"taxi_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'taxi'"
		},
		"S3_secretAccessKey": {
			"type": "secureString",
			"metadata": "Secure string for 'secretAccessKey' of 'S3'"
		},
		"NYCData_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://d37ci6vzurychx.cloudfront.net/trip-data/"
		},
		"taxi_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://siadp203sa.dfs.core.windows.net/"
		},
		"S3_properties_typeProperties_accessKeyId": {
			"type": "string",
			"defaultValue": "AKIAXZXUFBDQVYL3BHXZ"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "sia-dp203-data-factory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"taxi_accountKey": {
						"value": "[parameters('taxi_accountKey')]"
					},
					"S3_secretAccessKey": {
						"value": "[parameters('S3_secretAccessKey')]"
					},
					"NYCData_properties_typeProperties_url": {
						"value": "[parameters('NYCData_properties_typeProperties_url')]"
					},
					"taxi_properties_typeProperties_url": {
						"value": "[parameters('taxi_properties_typeProperties_url')]"
					},
					"S3_properties_typeProperties_accessKeyId": {
						"value": "[parameters('S3_properties_typeProperties_accessKeyId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}